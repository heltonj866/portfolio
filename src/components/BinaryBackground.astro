---
// Binary Background Stream (Monochrome Silver & Platinum Cyber Rain)
---

<canvas
  id="binary-canvas"
  class="fixed inset-0 pointer-events-none z-[1] w-full h-full opacity-30"
  aria-hidden="true"
></canvas>

<script>
  const canvas = document.getElementById('binary-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    const fontSize = 14;
    let columns = Math.floor(width / (fontSize * 1.8));
    let drops: number[] = [];

    function initDrops() {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      columns = Math.floor(width / (fontSize * 1.8));
      drops = [];
      for (let i = 0; i < columns; i++) {
        // Randomize initial vertical offsets
        drops[i] = Math.floor(Math.random() * -100);
      }
    }

    initDrops();

    window.addEventListener('resize', () => {
      initDrops();
    });

    const characters = ['0', '1'];

    let lastDraw = 0;
    const fps = 24; // Smooth, low-resource frame rate
    const interval = 1000 / fps;

    function draw(timestamp: number) {
      requestAnimationFrame(draw);

      if (timestamp - lastDraw < interval) return;
      lastDraw = timestamp;

      if (!ctx) return;

      // Desvanece o rastro sem escurecer o fundo (canvas permanece transparente)
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = 'rgba(0, 0, 0, 0.16)';
      ctx.fillRect(0, 0, width, height);
      ctx.globalCompositeOperation = 'source-over';

      ctx.font = `${fontSize}px "JetBrains Mono", monospace`;

      for (let i = 0; i < drops.length; i++) {
        const text = characters[Math.floor(Math.random() * characters.length)];
        const x = i * (fontSize * 1.8);
        const y = drops[i] * fontSize;

        // Leading character glows bright platinum/white, tail fades to translucent silver
        const isLeading = Math.random() > 0.88;
        if (isLeading) {
          ctx.fillStyle = '#ffffff';
          ctx.shadowColor = 'rgba(255, 255, 255, 0.85)';
          ctx.shadowBlur = 10;
        } else {
          ctx.fillStyle = 'rgba(203, 213, 225, 0.45)';
          ctx.shadowBlur = 0;
        }

        ctx.fillText(text, x, y);

        // Reset drop when off screen with random delay
        if (y > height && Math.random() > 0.978) {
          drops[i] = 0;
        }

        drops[i]++;
      }
    }

    requestAnimationFrame(draw);
  }
</script>
