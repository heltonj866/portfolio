---
import { PortfolioTabs } from './PortfolioTabs';
---

<section id="portfolio" class="py-20 sm:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-300 text-xs font-mono font-medium mb-3">
        <span>// PORTFÓLIO &amp; SISTEMAS</span>
      </div>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl text-white tracking-tight">
        Projetos Corporativos, Plataformas SaaS &amp; Competências
      </h2>
      <p class="text-slate-400 text-base max-w-2xl mt-4">
        Aplicações reais desenvolvidas para solucionar demandas críticas com estabilidade, escalabilidade e conformidade.
      </p>
    </div>

    <!-- Client-hydrated interactive tabs component -->
    <PortfolioTabs client:visible />

  </div>
</section>
