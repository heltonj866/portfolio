---
import { portfolioData } from '../data/portfolioData';
---

<footer class="mt-20 border-t border-white/10 bg-black relative z-10 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
    
    <!-- Brand & Copyright -->
    <div class="flex flex-col items-center md:items-start text-center md:text-left">
      <div class="flex items-center gap-2 mb-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-white"></span>
        <span class="font-heading font-bold text-lg text-white">
          {portfolioData.personal.displayName}<span class="text-slate-400">.</span>
        </span>
      </div>
      <p class="text-slate-400 text-xs">
        © 2026 {portfolioData.personal.fullName}. Todos os direitos reservados.
      </p>
      <p class="text-slate-500 text-[11px] font-mono mt-0.5">
        Desenvolvido com Astro, React, TypeScript, Tailwind CSS e Three.js.
      </p>
    </div>

    <!-- Quick Footer Links -->
    <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-slate-400">
      <a href="#home" class="hover:text-white transition-colors">Início</a>
      <a href="#about" class="hover:text-white transition-colors">Sobre</a>
      <a href="#services" class="hover:text-white transition-colors">Serviços</a>
      <a href="#process" class="hover:text-white transition-colors">Metodologia</a>
      <a href="#experience" class="hover:text-white transition-colors">Trajetória</a>
      <a href="#portfolio" class="hover:text-white transition-colors">Portfólio</a>
      <a href="#contact" class="hover:text-white transition-colors">Contato</a>
      <a href={portfolioData.personal.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn</a>
      <a href={portfolioData.personal.github} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
    </div>

    <!-- Back to Top Button with SVG -->
    <button
      id="back-to-top"
      type="button"
      aria-label="Voltar ao topo da página"
      class="px-4 py-2 rounded-full glass-panel border border-white/10 hover:border-white/30 text-slate-300 hover:text-white text-xs font-mono flex items-center gap-2 hover:scale-105 active:scale-95 transition-all"
    >
      <span>Voltar ao Topo</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>

  </div>
</footer>

<script>
  const backToTopBtn = document.getElementById('back-to-top');
  backToTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
