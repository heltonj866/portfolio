---
import { portfolioData } from '../data/portfolioData';
import { Hero3DContainer } from './Hero3DContainer';
---

<section id="home" class="relative pt-28 pb-16 sm:pt-36 sm:pb-24 lg:min-h-[100svh] lg:flex lg:items-center overflow-hidden">
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Presentation & CTAs -->
      <div class="lg:col-span-7 flex flex-col items-start text-left z-10">
        
        <!-- Status Pill: Apple Minimalist Silver & Dark -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-300 text-xs font-mono font-medium mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>CIÊNCIA DA COMPUTAÇÃO // EXÉRCITO BRASILEIRO</span>
        </div>

        <!-- Main H1 Headline: Platinum & Silver Text Gradient -->
        <h1 class="font-heading font-extrabold text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.1] text-white mb-4">
          Olá, sou <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-200 to-slate-400">Helton Junior</span>.
        </h1>

        <!-- Typewriter Animated Subtitle -->
        <div class="h-10 sm:h-12 flex items-center mb-6">
          <span class="font-mono text-lg sm:text-2xl text-slate-300 font-semibold">
            &gt; <span id="typewriter-text" class="text-white"></span>
            <span class="inline-block w-2.5 h-6 bg-white ml-1 animate-pulse"></span>
          </span>
        </div>

        <!-- Description Paragraph -->
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mb-8 font-normal">
          {portfolioData.personal.bioShort} Unindo lógica computacional, engenharia de software corporativo e infraestrutura robusta para transformar gargalos em soluções digitais de alto impacto.
        </p>

        <!-- CTAs: Apple Style Buttons -->
        <div class="flex flex-wrap items-center gap-4 mb-10 w-full sm:w-auto">
          <a
            href="#portfolio"
            class="w-full sm:w-auto px-7 py-3.5 rounded-full bg-white hover:bg-slate-200 text-black font-semibold text-sm shadow-[0_0_24px_rgba(255,255,255,0.2)] flex items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all group"
          >
            <span>Ver Projetos</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <a
            href="#services"
            class="w-full sm:w-auto px-7 py-3.5 rounded-full bg-white/5 hover:bg-white/10 text-white font-semibold text-sm border border-white/15 flex items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all"
          >
            <span>Serviços &amp; Soluções</span>
          </a>

          <a
            href={portfolioData.personal.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-5 py-3.5 rounded-full bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white font-medium text-xs border border-white/10 flex items-center justify-center gap-2 transition-all"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>

        <!-- Social Proof Numbers Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 w-full pt-6 border-t border-white/10">
          {portfolioData.stats.map((stat) => (
            <div>
              <div class="font-heading font-bold text-2xl sm:text-3xl text-white tracking-tight">
                {stat.value}
              </div>
              <div class="text-xs font-medium text-slate-400 mt-0.5">
                {stat.label}
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Right Column: Interactive 3D Canvas (Crachá ou Terminal) -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center gap-4">
        <Hero3DContainer client:load />
      </div>

    </div>
  </div>
</section>

<script>
  // Dynamic Typewriter Effect
  const words = [
    "Ciência da Computação",
    "Sistemas Corporativos",
    "Plataformas SaaS Multi-Tenant",
    "Automação de Processos com IA",
    "Infraestrutura de TI & Redes"
  ];
  let wordIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const targetElement = document.getElementById("typewriter-text");

  function type() {
    if (!targetElement) return;

    const currentWord = words[wordIndex];
    
    if (isDeleting) {
      targetElement.textContent = currentWord.substring(0, charIndex - 1);
      charIndex--;
    } else {
      targetElement.textContent = currentWord.substring(0, charIndex + 1);
      charIndex++;
    }

    let typeSpeed = isDeleting ? 40 : 80;

    if (!isDeleting && charIndex === currentWord.length) {
      typeSpeed = 2200; // Pause at end of word
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      wordIndex = (wordIndex + 1) % words.length;
      typeSpeed = 400;
    }

    setTimeout(type, typeSpeed);
  }

  type();
</script>
