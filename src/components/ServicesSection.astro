---
import { portfolioData } from '../data/portfolioData';
---

<section id="services" class="py-20 sm:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-300 text-xs font-mono font-medium mb-3">
        <span>// SERVIÇOS &amp; SOLUÇÕES</span>
      </div>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl text-white tracking-tight">
        Engenharia sob Medida para Empresas e Negócios
      </h2>
      <p class="text-slate-400 text-base max-w-2xl mt-4">
        Soluções completas com arquitetura corporativa, entrega pontual, código limpo e conformidade rigorosa.
      </p>
    </div>

    <!-- 4 Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 mb-16">
      {portfolioData.services.map((service) => (
        <article
          class="glass-panel relative rounded-3xl p-6 sm:p-8 flex flex-col justify-between hover:-translate-y-1.5 transition-all group overflow-hidden"
        >
          <!-- Top hairline shine -->
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>

          <div>
            <!-- Header Tag & Number -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 rounded-full bg-white/5 text-slate-300 border border-white/10 text-xs font-mono font-semibold">
                {service.category}
              </span>
              <span class="font-mono text-xs text-slate-500 font-bold tracking-widest">
                // {service.number}
              </span>
            </div>

            <!-- Title -->
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-white group-hover:text-slate-200 transition-colors mb-3">
              {service.title}
            </h3>

            <!-- Description -->
            <p class="text-slate-300 text-sm leading-relaxed mb-6 text-justify">
              {service.description}
            </p>

            <!-- Deliverables -->
            <div class="space-y-2 mb-6 pt-4 border-t border-white/10">
              <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block mb-2">
                O Que Está Incluído:
              </span>
              {service.deliverables.map((del) => (
                <div class="flex items-start gap-2.5 text-xs text-slate-300">
                  <svg class="w-3.5 h-3.5 text-slate-300 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>{del}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Technologies & Action -->
          <div class="pt-4 border-t border-white/10">
            <div class="flex flex-wrap gap-1.5 mb-5">
              {service.techs.map((tech) => (
                <span class="px-2.5 py-1 rounded-lg bg-white/5 border border-white/10 text-[11px] font-mono text-slate-300">
                  {tech}
                </span>
              ))}
            </div>

            <a
              href={`https://wa.me/5586994922976?text=Ol%C3%A1%20Helton,%20tenho%20interesse%20no%20servi%C3%A7o%20de%20*${encodeURIComponent(service.title)}*!`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 rounded-xl bg-white/10 hover:bg-white text-white hover:text-black text-xs font-semibold border border-white/15 flex items-center justify-center gap-2 transition-all shadow-sm"
            >
              <span>Consultar Escopo &amp; Disponibilidade</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Commercial Assurance Banner -->
    <div class="glass-panel rounded-3xl p-6 sm:p-8 border border-white/15 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div>
        <h4 class="font-heading font-bold text-lg sm:text-xl text-white">
          Precisa de uma Solução sob Demanda para sua Empresa?
        </h4>
        <p class="text-slate-300 text-xs sm:text-sm mt-1 max-w-xl">
          Atuo com contrato formal de prestação de serviços, termos de confidencialidade (NDA) e garantia de conformidade de código.
        </p>
      </div>

      <a
        href={portfolioData.personal.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3.5 rounded-full bg-white hover:bg-slate-200 text-black font-semibold text-xs sm:text-sm shadow-[0_0_20px_rgba(255,255,255,0.2)] shrink-0 transition-all hover:scale-105 active:scale-95"
      >
        Iniciar Conversa Técnica
      </a>
    </div>

  </div>
</section>
